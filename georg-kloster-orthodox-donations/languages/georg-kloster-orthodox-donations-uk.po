msgid "Secure payment. Your information is used only to process your prayer request."
msgstr "Безпечна оплата. Дані використовуються лише для обробки молитовної записки."

msgid "Please complete all required fields."
msgstr "Заповніть обов’язкові поля."

msgid "The request could not be processed. Please try again."
msgstr "Не вдалося обробити запит. Спробуйте ще раз."

msgid "Thank you. Your payment is confirmed and your prayer request has been received."
msgstr "Дякуємо. Оплату підтверджено, записку передано для молитовного поминання."

msgid "Thank you. Payment is still being confirmed. We will email you once the funds have arrived."
msgstr "Дякуємо. Оплата ще підтверджується. Після надходження коштів ми надішлемо підтвердження електронною поштою."

msgid "Payment was not completed. Your prayer request is temporarily saved."
msgstr "Оплату не завершено. Записку тимчасово збережено."

msgid "Payment successful"
msgstr "Оплата пройшла успішно"

msgid "Checking payment"
msgstr "Перевіряємо оплату"

msgid "Payment not completed"
msgstr "Оплату не завершено"

msgid "Understood"
msgstr "Зрозуміло"

msgid "per name"
msgstr "за ім’я"

msgid "per 10 names"
msgstr "за 10 імен"

msgid "Georg Kloster – Orthodox Donations"
msgstr "Православні пожертви"

msgid "Orthodox prayer requests and donations with Stripe, PayPal, printable prayer slips and reports."
msgstr "Православні молитовні записки та пожертви: Stripe, PayPal, друк записок і звіти."

msgid "Kloster: form not found."
msgstr "Форму молитовних записок не знайдено."

msgid "Prayer service"
msgstr "Треба"

msgid "Forbidden"
msgstr "Доступ заборонено"

msgid "https://atapin.de/"
msgstr "https://atapin.de/"

msgid "atapin.de"
msgstr "atapin.de"

msgid "Donation for the church"
msgstr "Пожертва на потреби храму"

msgid "Donate"
msgstr "Пожертвувати"

msgid "Secure payment. Your information is used only to process your donation."
msgstr "Безпечна оплата. Дані використовуються лише для обробки пожертви."

msgid "Thank you. Your donation is confirmed."
msgstr "Дякуємо. Вашу пожертву підтверджено."

msgid "Payment was not completed. Your donation has not been received."
msgstr "Оплату не завершено. Пожертва ще не надійшла."

msgid "Thank you for your donation"
msgstr "Дякуємо за вашу пожертву"

msgid "Amount in EUR: 0.50 to 999,999.99. Up to two decimal places."
msgstr "Сума в EUR: від 0,50 до 999 999,99. Не більше двох знаків після коми."

msgid "Enter a valid amount between 0.50 and 999,999.99 EUR."
msgstr "Вкажіть коректну суму від 0,50 до 999 999,99 EUR."

msgid "Campaign not found."
msgstr "Збір не знайдено."

msgid "Goal"
msgstr "Мета"

msgid "Expenses"
msgstr "Витрати"

msgid "Balance"
msgstr "Залишок"

msgid "Campaign progress"
msgstr "Перебіг збору"

msgid "Deadline"
msgstr "Термін завершення"

msgid "This campaign is closed."
msgstr "Прийом пожертв на цей збір закрито."

msgid "Campaigns"
msgstr "Цільові збори"

msgid "Campaign"
msgstr "Збір"

msgid "Report"
msgstr "Звіт"

msgid "Edit campaign"
msgstr "Редагувати збір"

msgid "New campaign"
msgstr "Новий збір"

msgid "Save campaign"
msgstr "Зберегти збір"

msgid "Record expense"
msgstr "Записати витрату"

msgid "Expenses are entered separately; payment providers do not report how funds are spent."
msgstr "Витрати вводяться окремо; платіжні системи не повідомляють, як витрачаються кошти."

msgid "Draft"
msgstr "Чернетка"

msgid "Closed"
msgstr "Закритий"

msgid "Log in to view your donations."
msgstr "Увійдіть, щоб переглянути свої пожертви."

msgid "Your donations"
msgstr "Ваші пожертви"

msgid "Only payments made while signed in to this account are shown. Guest payments are not linked by email."
msgstr "Показано лише платежі, зроблені після входу до цього облікового запису. Гостьові платежі не прив’язуються за email."

msgid "Previous"
msgstr "Назад"

msgid "Next"
msgstr "Далі"

msgid "Select all events for one-time donations, prayer requests and regular support:"
msgstr "Виберіть усі події для разових пожертв, молитовних записок і регулярної підтримки:"

msgid "Partially refunded"
msgstr "Частково повернено"

msgid "Log in and confirm recurring support before continuing."
msgstr "Увійдіть і підтвердьте згоду на регулярну підтримку."

msgid "Regular support"
msgstr "Регулярна підтримка"

msgid "Frequency"
msgstr "Періодичність"

msgid "Monthly"
msgstr "Щомісяця"

msgid "Yearly"
msgstr "Щорічно"

msgid "Repeat this amount at the selected interval until I cancel. I can cancel in my donation history."
msgstr "Повторювати цю суму з обраною періодичністю до мого скасування. Скасувати підтримку можна в історії пожертв."

msgid "Start regular support"
msgstr "Розпочати регулярну підтримку"

msgid "Stripe is not configured."
msgstr "Stripe не налаштовано."

msgid "PayPal is not configured or authentication failed."
msgstr "PayPal не налаштовано або авторизація не вдалася."

msgid "The payment provider is unavailable. Please try again."
msgstr "Платіжна система недоступна. Спробуйте ще раз."

msgid "The payment provider could not complete this operation."
msgstr "Платіжна система не змогла виконати цю операцію."

msgid "Invalid payment provider response."
msgstr "Некоректна відповідь платіжної системи."

msgid "PayPal is preparing recurring support. Please try again shortly."
msgstr "PayPal готує регулярну підтримку. Повторіть спробу трохи пізніше."

msgid "Log in to start regular support."
msgstr "Увійдіть, щоб розпочати регулярну підтримку."

msgid "Payment overdue"
msgstr "Оплату прострочено"

msgid "Actions"
msgstr "Дії"

msgid "User"
msgstr "Користувач"

msgid "Cancel regular support"
msgstr "Скасувати регулярну підтримку"

msgid "Closing a campaign prevents new submissions. Existing regular support continues until cancelled."
msgstr "Закриття збору забороняє нові заявки. Чинна регулярна підтримка триває до її скасування."

msgid "Help → Shortcodes"
msgstr "Допомога → Шорткоди"

msgid "Help"
msgstr "Допомога"

msgid "Prayer form. Without id or slug, uses the active gebetsanliegen form. An id takes precedence over a slug."
msgstr "Форма записок. Без id або slug використовується активна форма gebetsanliegen. Параметр id має пріоритет над slug."

msgid "Alias of gkod_form with the same parameters and behavior."
msgstr "Інша назва gkod_form із тими самими параметрами та поведінкою."

msgid "Form for one active service. Specify its id or slug; an id takes precedence. Find these values in Services."
msgstr "Форма однієї активної треби. Укажіть її id або slug; id має пріоритет. Значення містяться в розділі «Треби»."

msgid "One-time donation without prayer names or services. The donor enters an amount from 0.50 to 999,999.99 EUR."
msgstr "Разова пожертва без молитовних імен і треб. Жертводавець вводить суму від 0,50 до 999 999,99 EUR."

msgid "Monthly or yearly support. Requires login and explicit consent. The owner can cancel in donation history; configure recurring webhooks and WP-Cron first."
msgstr "Щомісячна або щорічна підтримка. Потрібні вхід і явна згода. Власник може скасувати її в історії пожертв; спочатку налаштуйте webhook-події підписок і WP-Cron."

msgid "Published campaigns with progress, totals and donation forms. Without id, shows up to 100 published campaigns. Drafts are hidden; closed or expired campaigns do not accept new payments."
msgstr "Опубліковані збори з прогресом, підсумками та формами пожертв. Без id показується до 100 зборів. Чернетки приховані; закриті й прострочені збори не приймають нових платежів."

msgid "Public report for one published campaign: goal, confirmed receipts after refunds, separately recorded expenses and balance. Does not disclose donor data or include a payment form."
msgstr "Публічний звіт одного опублікованого збору: мета, підтверджені надходження за вирахуванням повернень, окремо введені витрати та залишок. Без даних жертводавців і форми оплати."

msgid "Private payment history and regular-support cancellation for the signed-in account. Guest and historical payments are not assigned by email. Exclude this page from external full-page caches."
msgstr "Особиста історія платежів і скасування регулярної підтримки для користувача, який увійшов. Гостьові й попередні платежі не прив’язуються за email. Виключіть сторінку із зовнішнього повного кешу."

msgid "Payment result for the returned order, using its saved language. Has no shortcode parameters. Forms already include this block; use it separately on a custom return page. A return URL alone does not confirm payment."
msgstr "Результат оплати замовлення після повернення з платіжної сторінки, збереженою мовою замовлення. Параметрів немає. Форми вже містять цей блок; окремо використовуйте його на власній сторінці повернення. Саме повернення на сайт не підтверджує оплату."

msgid "Numeric form, service or campaign ID. Find it in the corresponding admin section. Required for a campaign report; optional for the campaign list."
msgstr "Числовий ID форми, треби або збору з відповідного розділу адмінки. Обов’язковий для звіту збору; необов’язковий для списку зборів."

msgid "Saved form or service slug. Used only when id is omitted or zero."
msgstr "Збережений slug форми або треби. Використовується лише коли id відсутній або дорівнює 0."

msgid "Layout: standard, compact, wide, two_columns, cards or minimal. Prayer forms default to their saved layout; other forms default to compact."
msgstr "Макет: standard, compact, wide, two_columns, cards або minimal. Для записок за замовчуванням використовується збережений макет форми, для решти форм — compact."

msgid "Language: en, ru, de, uk or pl. Omit it to use the current WordPress language. Existing prayer form/service content uses German as the English fallback."
msgstr "Мова: en, ru, de, uk або pl. Без параметра використовується поточна мова WordPress. Для англійської мови тексти наявних форм записок і треб беруться з німецьких полів."

msgid "yes (default) shows the form heading; no hides it. Not supported by gkod_service."
msgstr "yes (за замовчуванням) показує заголовок форми; no приховує його. Шорткод gkod_service не підтримує цей параметр."

msgid "Optional campaign ID. Omit it or use 0 for general church support. A specified campaign must be open and unexpired."
msgstr "Необов’язковий ID збору. Без нього або при 0 — підтримка загальних потреб храму. Указаний збір має бути відкритим, а його строк не повинен минути."

msgid "Compatibility parameter for gkod_donation: no (default) means one-time payment; yes displays recurring choices. Prefer gkod_support, which also checks login before showing the form."
msgstr "Параметр сумісності gkod_donation: no (за замовчуванням) — разовий платіж; yes показує регулярні варіанти. Використовуйте gkod_support: він також перевіряє вхід перед показом форми."

msgid "Copied."
msgstr "Скопійовано."

msgid "The example is selected. Copy it manually."
msgstr "Приклад виділено. Скопіюйте його вручну."

msgid "Language"
msgstr "Мова"

msgid "Add a Shortcode block to a WordPress page and paste an example. Replace example IDs and slugs with your saved values. Publish the page to display the form or report."
msgstr "Додайте блок «Шорткод» на сторінку WordPress і вставте приклад. Замініть ID та slug власними збереженими значеннями. Опублікуйте сторінку, щоб показати форму або звіт."

msgid "Choose a language above to translate this guide and the lang parameter in its examples. Keep shortcode names and parameter values unchanged."
msgstr "Виберіть мову вище: зміниться мова довідки та параметр lang у прикладах. Назви шорткодів і значення решти параметрів не перекладайте."

msgid "Parameters"
msgstr "Параметри"

msgid "No parameters."
msgstr "Без параметрів."

msgid "Examples to copy"
msgstr "Приклади для копіювання"

msgid "Shortcode example"
msgstr "Приклад шорткоду"

msgid "Copy"
msgstr "Копіювати"

msgid "English"
msgstr "Англійська"

msgid "Stripe setup — step-by-step instructions"
msgstr "Як підключити Stripe — покрокова інструкція"

msgid "Sign in to the Stripe account that will receive donations. Choose a Sandbox or test environment first. The API key and webhook must belong to the same account and environment."
msgstr "Увійдіть в акаунт Stripe отримувача пожертв. Почніть із Sandbox або тестового середовища. API-ключ і webhook мають належати одному акаунту й одному середовищу."

msgid "Open Stripe API keys"
msgstr "Відкрити API-ключі Stripe"

msgid "Reveal or create a Secret key on the API keys page and paste it into Secret Key. Test keys start with sk_test_, live keys with sk_live_. A pk_ publishable key, account password or whsec_ signing secret cannot replace it."
msgstr "На сторінці API-ключів відкрийте або створіть Secret key і вставте його в Secret Key. Тестовий ключ починається з sk_test_, робочий — зі sk_live_. Публічний ключ pk_, пароль акаунта та секрет підпису whsec_ не підходять."

msgid "Open Stripe Webhooks / Workbench"
msgstr "Відкрити Webhooks / Workbench Stripe"

msgid "In Workbench → Webhooks, choose Create an event destination (or Add destination / Add endpoint in older dashboards). Choose Your account, the Snapshot payload format and Webhook endpoint as the destination. This plugin does not process Thin events."
msgstr "У Workbench → Webhooks натисніть Create an event destination (у старому інтерфейсі — Add destination / Add endpoint). Виберіть Your account, формат даних Snapshot і призначення Webhook endpoint. Плагін не обробляє події Thin."

msgid "Paste the exact Endpoint URL below. It must be publicly accessible over HTTPS and accept POST requests without login, redirects or a security challenge. Do not enter the WordPress settings-page URL."
msgstr "Вставте вказану нижче адресу Endpoint URL без змін. Вона має бути публічно доступною через HTTPS і приймати POST без входу, перенаправлень та захисної перевірки. Не вставляйте адресу сторінки налаштувань WordPress."

msgid "For one-time donations and prayer requests, select checkout.session.completed and charge.refunded. For regular support, additionally select the following subscription and invoice events. Save the destination."
msgstr "Для разових пожертв і записок виберіть checkout.session.completed та charge.refunded. Для регулярної підтримки додатково виберіть наведені нижче події підписок і рахунків. Збережіть призначення."

msgid "Open the saved destination and reveal its Signing secret, starting with whsec_. Paste it into Webhook Secret. Use the secret of this exact endpoint and environment, not a Stripe CLI listener secret. Enable Stripe and save the plugin settings."
msgstr "Відкрийте збережене призначення й покажіть Signing secret, що починається з whsec_. Вставте його у Webhook Secret. Потрібен секрет саме цієї кінцевої точки й середовища, а не слухача Stripe CLI. Увімкніть Stripe і збережіть налаштування плагіна."

msgid "A blank Secret Key or Webhook Secret field preserves the saved value. When switching to Live, replace both values with the Live account key and Live endpoint signing secret. The plugin stores one set of Stripe credentials."
msgstr "Порожні поля Secret Key та Webhook Secret зберігають попередні значення. При переході в Live замініть обидва значення ключем робочого акаунта та секретом підпису робочого webhook. Плагін зберігає один комплект даних Stripe."

msgid "Submit a real checkout from a page on your test site. In the test environment, use a Stripe test card from the official testing guide, not a real card. Verify Paid status and configured emails. For regular support, also test a payment cycle, cancellation and refunds."
msgstr "Пройдіть справжній checkout зі сторінки тестового сайту. У тестовому середовищі використовуйте тестову картку Stripe з офіційної інструкції, а не реальну картку. Перевірте статус «Оплачено» й налаштовані листи. Для регулярної підтримки також перевірте цикл оплати, скасування та повернення."

msgid "Stripe test cards and testing guide"
msgstr "Тестові картки Stripe та інструкція з перевірки"

msgid "In the destination, inspect event deliveries and their HTTP responses. A successful delivery should return 2xx. Fix the cause before resending a failed event: 400 can indicate a wrong signing secret, payload format or payment mismatch; 404 indicates a wrong endpoint URL; 403 or a security page can indicate blocked POST requests."
msgstr "У призначенні перевірте доставку подій і HTTP-відповіді. Успішна доставка повертає 2xx. Перед повторним надсиланням виправте причину: 400 може означати неправильний секрет підпису, формат даних або невідповідність платежу; 404 — неправильну адресу; 403 або захисна сторінка — блокування POST."

msgid "Opening the webhook URL in a browser sends GET and is not a payment test. A Dashboard sample event may not match a saved plugin order. Test a checkout created by this plugin and inspect its event delivery. A success return URL alone does not confirm payment."
msgstr "Відкриття webhook у браузері надсилає GET і не перевіряє оплату. Приклад події з Dashboard може не відповідати збереженому замовленню плагіна. Перевірте checkout, створений плагіном, і доставку його події. Саме повернення на сторінку успіху не підтверджує оплату."

msgid "After a domain move, update the destination URL in Stripe. Never publish API keys or signing secrets. Plugin diagnostics checks whether settings exist, not whether Stripe accepts them."
msgstr "Після зміни домену оновіть адресу призначення у Stripe. Не публікуйте API-ключі та секрети підпису. Діагностика плагіна перевіряє наявність налаштувань, а не їх прийняття Stripe."

msgid "Stripe documentation: API keys"
msgstr "Документація Stripe: API-ключі"

msgid "Stripe documentation: webhook setup and signatures"
msgstr "Документація Stripe: налаштування webhook та підписи"

msgid "Language override: en, ru, de, uk or pl. Usually omit it: the site follows the current WPML/Polylang language, or WordPress without a language plugin. Existing prayer form/service content uses German as the English fallback."
msgstr "Примусова мова: en, ru, de, uk або pl. Зазвичай параметр не потрібний: сайт використовує поточну мову WPML/Polylang, а без мовного плагіна — WordPress. Для англійської мови тексти наявних форм записок і треб беруться з німецьких полів."
msgid "Campaign image"
msgstr "Зображення збору"
msgid "Replace the URL in the compact shortcode with the page that contains the full campaign and donation form."
msgstr "Замініть URL у компактному шорткоді адресою сторінки з повним описом збору та формою пожертви."
msgid "Compact campaign block"
msgstr "Компактний блок збору"
msgid "Recorded expenses"
msgstr "Витрати"
msgid "Full campaign"
msgstr "Повний збір"
msgid "Delete"
msgstr "Видалити"
msgid "Layout for forms: standard, compact, wide, two_columns, cards or minimal. For campaign lists, use compact for a small linked card; full shows the description, reports, and donation form."
msgstr "Варіант форми: standard, compact, wide, two_columns, cards або minimal. Для списку зборів compact показує невеликий блок із посиланням; full — опис, звіти та форму пожертви."
msgid "Embed this campaign"
msgstr "Вбудувати збір"
msgid "Choose an amount or enter your own. Minimum: %s EUR."
msgstr "Виберіть суму або введіть власну. Мінімум: %s EUR."
msgid "Use this image"
msgstr "Використати це зображення"
msgid "Published campaigns with progress, totals and donation forms. Use layout=\"compact\" for a small campaign card and url=\"/donate/\" to link it to the full campaign page. Without id, shows up to 100 published campaigns. Drafts are hidden; closed or expired campaigns do not accept new payments."
msgstr "Опубліковані збори з перебігом, підсумками та формами пожертв. Використовуйте layout=\"compact\" для невеликого блоку з посиланням на повну сторінку збору. Без id показуються до 100 опублікованих зборів. Чернетки приховані; закриті або прострочені збори не приймають пожертви."
msgid "Remove image"
msgstr "Видалити зображення"
msgid "Other amount"
msgstr "Інша сума"
msgid "Choose image"
msgstr "Вибрати зображення"
msgid "Delete this expense?"
msgstr "Видалити цю витрату?"
msgid "The expense could not be found."
msgstr "Витрату не знайдено."
msgid "Destination page for a compact campaign card, normally the page containing the full campaign and donation form."
msgstr "Сторінка призначення для компактного блоку збору — зазвичай сторінка з повним описом і формою пожертви."
msgid "Edit expense"
msgstr "Змінити витрату"
msgid "Choose campaign image"
msgstr "Виберіть зображення збору"
msgid "Suggested amount %d"
msgstr "Запропонована сума %d"
msgid "Minimum donation"
msgstr "Мінімальна пожертва"

msgid "The minimum donation for this campaign is %s EUR."
msgstr "Мінімальна сума пожертви для цього збору — %s EUR."

msgid "A valid Stripe Secret Key is required to synchronize products."
msgstr "Для синхронізації товарів потрібен дійсний секретний ключ Stripe."

msgid "Stripe did not return a product and its price."
msgstr "Stripe не повернув товар і його ціну."

msgid "The Stripe product was created but its link could not be saved in WordPress."
msgstr "Товар створено у Stripe, але зберегти зв’язок із ним у WordPress не вдалося."

msgid "Stripe did not return a price ID."
msgstr "Stripe не повернув ідентифікатор ціни."

msgid "The Stripe product was updated but its link could not be saved in WordPress."
msgstr "Товар оновлено у Stripe, але зберегти зв’язок із ним у WordPress не вдалося."

msgid "Stripe API request failed."
msgstr "Запит до API Stripe завершився помилкою."

msgid "Stripe synchronization finished: %1$d created, %2$d updated, %3$d failed."
msgstr "Синхронізацію зі Stripe завершено: створено — %1$d, оновлено — %2$d, помилок — %3$d."

msgid "Sync every service to the Stripe Product Catalog. Product titles, descriptions, images and the current unit prices are maintained there; Checkout uses the calculated quantity."
msgstr "Синхронізуйте всі треби з каталогом товарів Stripe. Там оновлюватимуться назви, описи, зображення та поточні ціни; під час оплати використовується розрахована кількість."

msgid "Synchronize services with Stripe"
msgstr "Синхронізувати треби зі Stripe"

msgid "names"
msgstr "імен"

msgid "prayer slips"
msgstr "молитовних записок"
